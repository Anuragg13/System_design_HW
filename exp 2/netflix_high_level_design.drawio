        <!-- FUNCTIONAL REQUIREMENTS BOX -->
        <mxCell id="fr" value="Functional Requirements&#10;&#10;1. Users can sign up, log in, and manage multiple profiles under one account.&#10;2. Users can browse and search the video catalog by title, genre, or actor.&#10;3. Users can stream video content with adaptive bitrate based on network conditions.&#10;4. System provides personalized recommendations based on viewing history.&#10;5. Users can resume playback from the last watched position across devices." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="580" height="200" as="geometry" />
        </mxCell>

        <!-- NON FUNCTIONAL REQUIREMENTS BOX -->
        <mxCell id="nfr" value="Non-Functional Requirements&#10;&#10;1. High availability - target 99.99% uptime globally.&#10;2. Low latency - video start time under 100ms, minimal buffering.&#10;3. Scalability - support 200M+ registered users and millions of concurrent streams.&#10;4. Durability - zero data loss for video assets and user data (replicated storage).&#10;5. Global reach - low-latency content delivery via geographically distributed CDN edge nodes." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="540" width="580" height="200" as="geometry" />
        </mxCell>

        <!-- DATABASE DESIGN BOX -->
        <mxCell id="dbbox" value="Database Design&#10;&#10;- User DB (MySQL/RDBMS): user_id, email, password_hash, plan, profiles[]&#10;- Metadata DB (MySQL): title_id, name, genre, cast, description, encoding_urls&#10;- Viewing History DB (Cassandra, high write throughput): user_id, title_id, timestamp, playback_position&#10;- Billing DB (MySQL): user_id, plan_id, payment_method, invoice_history&#10;- Recommendation Store (Cassandra/Feature Store): user_id, embeddings, watch_signals&#10;- Search Index (Elasticsearch): denormalized title metadata for fast search" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="580" height="220" as="geometry" />
        </mxCell>

        <!-- CAPACITY ESTIMATION BOX -->
        <mxCell id="capbox" value="Capacity / Envelope Estimation&#10;&#10;Assumptions: 250M total users, 40% DAU = 100M daily active users&#10;- Concurrent streams (peak, ~20% of DAU): ~20M concurrent streams&#10;- Avg bitrate per stream: 5 Mbps (HD) -&gt; Peak bandwidth: 20M x 5Mbps = 100 Tbps (served mostly via CDN edge caches)&#10;- Avg video size: 1-4 GB/title (encoded in multiple resolutions/codecs)&#10;- Catalog size: ~15,000 titles x multiple encodes x avg 3GB = several PB of raw storage&#10;- Metadata QPS: ~50K-100K reads/sec at peak (search + browse)&#10;- Viewing history writes: 100M DAU x ~5 events/session = ~500M writes/day (~6K writes/sec avg, higher at peak)&#10;- Storage growth: assume 500 new/updated titles per month x 3GB avg x multiple encodes = tens of TB/month" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="760" width="580" height="220" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
